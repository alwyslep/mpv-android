<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="FilePickerTheme" parent="Theme.AppCompat">
        <item name="nnf_separator_color">@color/primary</item>

        <!-- Set these to match your theme -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Need to set this also to style create folder dialog -->
        <item name="alertDialogTheme">@style/FilePickerTheme.AlertDialog</item>
        <item name="android:textColorPrimary">@android:color/background_light</item>
        <item name="android:textColorLink">@android:color/background_light</item>
    </style>

    <style name="FilePickerThemeSpecial" parent="FilePickerTheme">
        <!-- used to draw behind navigation bar -->
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="FilePickerTheme.AlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
    </style>

    <!-- theme for player UI -->
    <style name="AppTheme" parent="Theme.AppCompat.Light">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- theme for preferences -->
    <style name="AppTheme.Preference" parent="Theme.Material3.DayNight">
        <item name="toolbarStyle">@style/AppTheme.Toolbar.Style</item>
        <item name="alertDialogTheme">@style/AppTheme.Preference.AlertDialog</item>
        <item name="preferenceTheme">@style/JavPreferenceTheme</item>
    </style>

    <!-- 7: 소울 벤치마킹 — 설정 항목을 반투명 카드형으로(오로라 배경 비침) -->
    <style name="JavPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/JavPref</item>
        <item name="switchPreferenceCompatStyle">@style/JavPref.Switch</item>
        <item name="dialogPreferenceStyle">@style/JavPref.Dialog</item>
    </style>
    <style name="JavPref" parent="@style/Preference.Material">
        <item name="android:layout">@layout/pref_jav_item</item>
    </style>
    <style name="JavPref.Switch" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/pref_jav_item</item>
    </style>
    <style name="JavPref.Dialog" parent="@style/Preference.DialogPreference.Material">
        <item name="android:layout">@layout/pref_jav_item</item>
    </style>

    <style name="AppTheme.Toolbar.Style" parent="Widget.Material3.Toolbar">
        <item name="android:background">?colorSurface</item>
    </style>

    <style name="AppTheme.Preference.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="cornerFamily">rounded</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
    </style>

    <!-- 24: 재생 중 더보기 팝업 — 다크(영상 위 라이트 방지). AppCompat 다이얼로그(커스텀 뷰 호환). -->
    <style name="DarkPopupDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_pref_card</item>
        <item name="colorAccent">#FFB300</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#C8C8CC</item>
    </style>


    <!-- P2: 미디어 라이브러리 홈 (NextPlayer식 다크 Material3, 자체 Toolbar 사용 → NoActionBar) -->
    <style name="MediaLibraryTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- P2: 빠른설정 필드 칩 — ○(미선택)/✓(선택) 선두 아이콘(NextPlayer식) -->
    <style name="FieldChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipIcon">@drawable/ic_circle_outline_24</item>
        <item name="chipIconVisible">true</item>
        <item name="checkedIcon">@drawable/ic_check_circle_24</item>
        <item name="checkedIconVisible">true</item>
    </style>

    <!-- P2: 빠른설정 정렬 아이콘 셀(균등 분포) -->
    <style name="SortCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- P2: 빠른설정 시트 섹션 라벨 -->
    <style name="QsLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Material3 Switches -->
    <style name="Preference.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material" tools:override="true">
        <item name="android:widgetLayout">@layout/material_preferences_switch</item>
    </style>
</resources>
