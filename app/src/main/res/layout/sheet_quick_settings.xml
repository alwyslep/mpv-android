<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qs_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView style="@style/QsLabel" android:text="@string/qs_view_mode" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_mode_tree"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_tree" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_mode_folder"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_folder" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_mode_videos"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_videos" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView style="@style/QsLabel" android:text="@string/qs_watch_status" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_watch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/w_all"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_all" />
            <com.google.android.material.button.MaterialButton android:id="@+id/w_unwatched"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_unwatched" />
            <com.google.android.material.button.MaterialButton android:id="@+id/w_watching"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_watching" />
            <com.google.android.material.button.MaterialButton android:id="@+id/w_watched"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_watched" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView style="@style/QsLabel" android:text="@string/qs_favorites" />
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.chip.Chip android:id="@+id/chip_fav_only" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_fav_only" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_embed_filter" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="임베드없음" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_merge_drives" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="드라이브폴더병합" />
        </com.google.android.material.chip.ChipGroup>

        <TextView style="@style/QsLabel" android:text="@string/qs_layout" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_list"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_list" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_grid"
                style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/qs_grid" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView style="@style/QsLabel" android:text="@string/qs_cover_size" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <SeekBar
                android:id="@+id/qs_cover_scale"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:max="150" />
            <TextView
                android:id="@+id/qs_cover_scale_label"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView style="@style/QsLabel" android:text="커버 정렬 (임베드 커버만 · 추출 썸네일은 중앙 고정)" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_cover_align"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/ca_left" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="좌" />
            <com.google.android.material.button.MaterialButton android:id="@+id/ca_center" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="중앙" />
            <com.google.android.material.button.MaterialButton android:id="@+id/ca_right" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="우" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 26: 정렬 섹션은 각 화면 정렬 버튼(SortDialog)으로 이동 — 빠른설정에서 제거 -->

        <TextView style="@style/QsLabel" android:text="@string/qs_fields" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grp_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_dur" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_duration" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_ext" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_ext" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_path" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_path" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_progress" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_progress" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_res" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_resolution" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_size" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_size" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_thumb" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_thumbnail" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_f_fav" style="@style/FieldChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/qs_favorites" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_cancel"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/dialog_cancel" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_done"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/qs_done" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
