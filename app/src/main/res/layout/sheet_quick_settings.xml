<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="빠른 설정"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="레이아웃"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_list"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목록" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_grid"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="그리드" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="정렬"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort_name"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort_date"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="날짜" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sort_size"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="크기" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grp_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_asc"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오름차순 ↑" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_desc"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내림차순 ↓" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="필드 표시"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />
        <CheckBox
            android:id="@+id/cb_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="경로"
            android:textColor="?attr/colorOnSurface" />
        <CheckBox
            android:id="@+id/cb_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="크기"
            android:textColor="?attr/colorOnSurface" />
        <CheckBox
            android:id="@+id/cb_res"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="해상도"
            android:textColor="?attr/colorOnSurface" />
        <CheckBox
            android:id="@+id/cb_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="길이"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>
</ScrollView>
