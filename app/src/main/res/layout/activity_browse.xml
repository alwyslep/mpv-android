<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextColor="?attr/colorOnSurface" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/grp_dim"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/dim_actor"
            style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="배우" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dim_studio"
            style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="스튜디오" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dim_series"
            style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="시리즈" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="4dp"
        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</LinearLayout>
